# Copy to .env for local development (docker-compose reads this automatically).
# In production, set these as real environment variables / secrets — never
# commit a real .env file.

ADDR=:8080
ENVIRONMENT=development

DB_PATH=data/reports.db
UPLOADS_DIR=data/uploads
WEB_DIR=web

# Public URL citizens' links (verification page, evidence upload) are built
# from. Must be reachable from a citizen's phone/browser.
PUBLIC_BASE_URL=http://localhost:8080

# --- Secrets: MUST be overridden with long random values in production ---
JWT_SECRET=dev-only-insecure-secret-change-me
PHONE_PEPPER=dev-only-pepper-change-me

# --- Tuning (sane defaults shown) ---
TOKEN_TTL=12h
SESSION_TTL=3m
REQUEST_TIMEOUT=10s
SHUTDOWN_GRACE=15s
MAX_UPLOAD_MB=8
EVIDENCE_WINDOW=72h
VERIFY_ANOMALY_THRESHOLD=5
VERIFY_ANOMALY_WINDOW=15m
IDCARD_TTL=2160h

# Bootstrap admin (only used the very first time the system starts with no
# admin users at all — the password is generated randomly and printed once
# to the server logs, never stored in plaintext).
BOOTSTRAP_ADMIN_EMAIL=admin@ussd.local
